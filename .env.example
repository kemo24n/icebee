# Supabase → Project Settings → Database → Connection string
# Pooled (port 6543, "Transaction" mode) – used by the app:
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct (port 5432) – used for creating tables:
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Any long random string (keeps staff logins secure)
AUTH_SECRET="change-me-to-a-long-random-string"
# Optional: your public site address, used in QR codes on the menu screens
PUBLIC_URL="https://ice-bee.onrender.com"
# Optional – WhatsApp Cloud API (Meta) for real owner alerts
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
OWNER_WHATSAPP="9639XXXXXXXX"
NOTIFY_ORDERS="0"
